# 🧭 OpenCode Environment Variables

# AI Provider Configuration
# Default provider (anthropic | google)
OPENCODE_PROVIDER=google
# Default model ID
OPENCODE_MODEL=gemini-3.1-pro-preview

# API Keys
# Get your Anthropic key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Get your Google Gemini key at: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here

# Server Configuration
# Port for the Hono HTTP server (default: 4096)
PORT=4096

# Project Configuration
# Default working directory (defaults to current process directory)
OPENCODE_DIRECTORY=.

# Logging & Debugging
# Set to 'debug' for more verbose output
LOG_LEVEL=info
